{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bella-forever-catalog",
	"compatibility_date": "2026-07-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"pages_build_output_dir": "dist",
	"r2_buckets": [
		{
			"binding": "BELLA_IMAGES",
			"bucket_name": "bella"
		}
	],
	"d1_databases": [
		{
			"binding": "bella_forever_db",
			"database_name": "bella-forever-db",
			"database_id": "3cf2ed19-16b9-44eb-b3c3-e6bd4106c3b7"
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	}
}
