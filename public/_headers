# Static assets caching
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/isotipo.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/logo.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/llms.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200

/llms-full.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
