---
interface Props {
  siteUrl?: string;
}

const { siteUrl = 'https://bella-forever.com' } = Astro.props;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Bella Forever",
  "alternateName": ["Bella Forever Beauty", "Bella Forever Maquillaje"],
  "url": siteUrl,
  "inLanguage": "es-CO",
  "description": "Tienda boutique y catálogo digital de maquillaje y cosméticos de alta gama en Roldanillo, Valle del Cauca.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteUrl}/catalogo?q={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
