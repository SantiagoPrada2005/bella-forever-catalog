---
interface FaqItem {
  question: string;
  answer: string;
}

const faqs: FaqItem[] = [
  {
    question: "¿Dónde comprar maquillaje y cosméticos originales en Roldanillo?",
    answer: "Bella Forever es la boutique de belleza líder en Roldanillo, Valle del Cauca. Ofrecemos maquillaje de alta calidad, productos en tendencia y marcas de prestigio con asesoría personalizada de Silvy Loaiza a través de nuestro catálogo digital interactivo.",
  },
  {
    question: "¿Cómo funciona la compra a través del catálogo digital de Bella Forever?",
    answer: "Explora las secciones de rubor, labiales velvet, correctores, cejas y pestañinas. Selecciona el tono que deseas, agrégalo a tu bolsa de compra y presiona 'Pedir por WhatsApp'. Se abrirá un chat directo con el listado detallado para confirmar tu pedido y coordinar entrega.",
  },
  {
    question: "¿Qué marcas y tipos de productos tienen disponibles en tienda?",
    answer: "Contamos con cosméticos originales de alta gama y marcas aliadas como Trendy, además de las colecciones exclusivas de Bella Forever: rubor en barra Pocket Blush, kits para labios Soda Pop Kit, máscara dúo Gold Eyes, geles fijadores para cejas y correctores faciales de alta cobertura.",
  },
  {
    question: "¿Cómo elegir el tono adecuado de rubor o corrector para mi tipo de piel?",
    answer: "En Bella Forever brindamos asesoría individualizada. Puedes escribirnos a nuestro WhatsApp (+57 311 788 7806) y te guiaremos según tu subtono (cálido, neutro o frío) para que elijas entre tonos melocotón, rosados o satinados en Pocket Blush y la tonalidad exacta en correctores.",
  },
  {
    question: "¿Realizan envíos a municipios cercanos como La Unión, Zarzal, Cartago o Cali?",
    answer: "Sí. Además de entregas rápidas en Roldanillo, realizamos envíos a todo el norte del Valle del Cauca (La Unión, Zarzal, Bolívar, Toro, Cartago, Tuluá) y cobertura nacional en Colombia a través de empresas de mensajería certificadas.",
  },
  {
    question: "¿Cuáles son los métodos de pago aceptados para los pedidos?",
    answer: "Aceptamos transferencias electrónicas por Bancolombia, Nequi y Daviplata. Para clientas con entrega directa en el perímetro urbano de Roldanillo, también está disponible la modalidad de pago en efectivo contra entrega.",
  },
  {
    question: "¿Los productos son aptos para pieles sensibles y de larga duración?",
    answer: "Todos los productos del catálogo cuentan con fórmulas probadas, hipoalergénicas y de excelente pigmentación, pensadas para resistir el clima cálido del Valle del Cauca manteniendo el brillo y la fijación intactos durante toda la jornada.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
};
---

<section
  class="editorial-section-shell"
  aria-labelledby="faq-section-title"
>
  <div
    style={{
      maxWidth: "920px",
      margin: "0 auto",
      backgroundColor: "rgba(18, 9, 11, 0.72)",
      border: "1px solid rgba(215, 176, 106, 0.25)",
      borderRadius: "24px",
      padding: "clamp(24px, 5vw, 36px) clamp(16px, 4vw, 28px)",
      backdropFilter: "blur(14px)",
      boxSizing: "border-box",
      width: "100%",
    }}
  >
    <div style={{ textAlign: "center", marginBottom: "32px" }}>
      <span
        style={{
          color: "var(--color-gold)",
          fontSize: "0.76rem",
          letterSpacing: "0.2em",
          textTransform: "uppercase",
          fontWeight: 600,
          display: "block",
          marginBottom: "8px",
        }}
      >
        Resolución de Dudas
      </span>
      <h2
        id="faq-section-title"
        style={{
          fontFamily: "var(--font-serif)",
          fontSize: "clamp(1.75rem, 4vw, 2.45rem)",
          fontWeight: 400,
          color: "var(--color-white)",
          margin: 0,
        }}
      >
        Preguntas Frecuentes sobre Bella Forever en Roldanillo
      </h2>
    </div>

    <div style={{ display: "flex", flexDirection: "column", gap: "16px" }}>
      {faqs.map((faq) => (
        <details
          style={{
            backgroundColor: "rgba(90, 22, 35, 0.18)",
            border: "1px solid rgba(215, 176, 106, 0.22)",
            borderRadius: "14px",
            padding: "16px 20px",
            color: "var(--color-text-light)",
            transition: "background-color 0.2s ease",
          }}
        >
          <summary
            style={{
              fontFamily: "var(--font-serif)",
              fontSize: "1.15rem",
              fontWeight: 500,
              color: "var(--color-gold)",
              cursor: "pointer",
              userSelect: "none",
              listStyle: "none",
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              gap: "12px",
            }}
          >
            <span>{faq.question}</span>
            <span style={{ fontSize: "1.2rem", color: "var(--color-gold)", flexShrink: 0 }}>
              ▾
            </span>
          </summary>
          <p
            style={{
              margin: "12px 0 0 0",
              fontSize: "0.9rem",
              lineHeight: "1.65",
              color: "rgba(255, 255, 255, 0.82)",
            }}
          >
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
