---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header";
import EditorialHero from "../components/EditorialHero";
import BrandStory from "../components/BrandStory";
import ParallaxGallery from "../components/ParallaxGallery";
import { CONFIG } from "../config";
---

<Layout>
  <link
    rel="preload"
    as="image"
    href="/images/studio-hero-blush.webp"
    fetchpriority="high"
    slot="head"
  />
  <div
    style={{
      minHeight: "100dvh",
      display: "flex",
      flexDirection: "column",
      backgroundColor: "var(--color-bg-dark)",
      paddingTop: "70px",
    }}
  >
    <div class="bg-makeup-blur bg-makeup-blur-1"></div>
    <div class="bg-makeup-blur bg-makeup-blur-2"></div>

    <Header client:load cartCount={0} />

    <main style={{ flex: "1 0 auto", paddingBottom: "32px" }}>
      <EditorialHero client:load />
      <BrandStory client:visible />
      <ParallaxGallery client:visible />
    </main>

    <!-- Footer Editorial -->
    <footer
      style={{
        padding: "36px 24px",
        borderTop: "var(--border-glass)",
        textAlign: "center",
        color: "var(--color-text-muted)",
        fontSize: "0.82rem",
        backgroundColor: "rgba(18, 9, 11, 0.55)",
        backdropFilter: "blur(12px)",
      }}
    >
      <p
        style={{
          fontFamily: "var(--font-serif)",
          fontSize: "1.35rem",
          color: "var(--color-gold)",
          marginBottom: "6px",
          letterSpacing: "0.16em",
        }}
      >
        BELLA FOREVER
      </p>
      <p
        style={{
          marginBottom: "6px",
          letterSpacing: "0.08em",
          textTransform: "uppercase",
          fontSize: "0.72rem",
        }}
      >
        {CONFIG.defaultCity} · Valle del Cauca
      </p>
      <p style={{ fontSize: "0.78rem" }}>
        Curaduría por <a
          href={`https://instagram.com/${CONFIG.instagramUser}`}
          target="_blank"
          rel="noopener noreferrer"
          style={{
            color: "var(--color-gold)",
            fontWeight: "600",
            textDecoration: "none",
          }}>@{CONFIG.instagramUser}</a
        >
      </p>
    </footer>
  </div>
</Layout>
