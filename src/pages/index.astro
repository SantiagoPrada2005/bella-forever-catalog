---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header";
import EditorialHero from "../components/EditorialHero";
import BrandStory from "../components/BrandStory";
import ParallaxGallery from "../components/ParallaxGallery";
import AboutBrandSection from "../components/seo/AboutBrandSection.astro";
import FaqSection from "../components/seo/FaqSection.astro";
import { CONFIG } from "../config";
---

<Layout>
  <link
    rel="preload"
    as="image"
    href="/images/studio-hero-blush.webp"
    fetchpriority="high"
    slot="head"
  />
  <div
    style={{
      minHeight: "100dvh",
      display: "flex",
      flexDirection: "column",
      backgroundColor: "var(--color-bg-dark)",
      paddingTop: "70px",
    }}
  >
    <div class="bg-makeup-blur bg-makeup-blur-1"></div>
    <div class="bg-makeup-blur bg-makeup-blur-2"></div>

    <Header client:load cartCount={0} />

    <main style={{ flex: "1 0 auto", paddingBottom: "32px", display: "flex", flexDirection: "column", gap: "24px" }}>
      <EditorialHero client:load />
      <BrandStory client:visible />
      <ParallaxGallery client:visible />
      <AboutBrandSection />
      <FaqSection />
    </main>

    <!-- Footer Editorial con NAP (Name, Address, Phone) para Local SEO -->
    <footer
      style={{
        padding: "40px 24px 32px",
        borderTop: "var(--border-glass)",
        textAlign: "center",
        color: "var(--color-text-muted)",
        fontSize: "0.82rem",
        backgroundColor: "rgba(18, 9, 11, 0.75)",
        backdropFilter: "blur(14px)",
      }}
    >
      <div style={{ maxWidth: "680px", margin: "0 auto", display: "flex", flexDirection: "column", gap: "10px" }}>
        <p
          style={{
            fontFamily: "var(--font-serif)",
            fontSize: "1.45rem",
            color: "var(--color-gold)",
            margin: 0,
            letterSpacing: "0.16em",
          }}
        >
          BELLA FOREVER
        </p>
        <p
          style={{
            margin: 0,
            letterSpacing: "0.08em",
            textTransform: "uppercase",
            fontSize: "0.76rem",
            color: "var(--color-text-light)",
          }}
        >
          Boutique de Maquillaje y Belleza · {CONFIG.defaultCity}, Valle del Cauca, Colombia
        </p>
        <p style={{ margin: 0, fontSize: "0.82rem" }}>
          <strong style={{ color: "var(--color-gold)" }}>Pedidos y Asesoría WhatsApp:</strong>{" "}
          <a
            href={`https://wa.me/${CONFIG.whatsappNumber.replace(/[^0-9]/g, '')}`}
            target="_blank"
            rel="noopener noreferrer"
            style={{
              color: "var(--color-gold)",
              textDecoration: "underline",
              fontWeight: 600,
            }}
          >
            {CONFIG.whatsappNumber}
          </a>
        </p>
        <p style={{ margin: "4px 0 0", fontSize: "0.8rem" }}>
          Curaduría exclusiva por{" "}
          <a
            href={`https://instagram.com/${CONFIG.instagramUser}`}
            target="_blank"
            rel="noopener noreferrer"
            style={{
              color: "var(--color-gold)",
              fontWeight: "600",
              textDecoration: "none",
            }}
          >
            @{CONFIG.instagramUser}
          </a>
          {" · "}
          <a
            href="/catalogo"
            style={{
              color: "var(--color-text-light)",
              textDecoration: "underline",
              fontWeight: 500,
            }}
          >
            Ver Catálogo Digital
          </a>
        </p>
        <p style={{ margin: "8px 0 0", fontSize: "0.72rem", color: "rgba(255, 255, 255, 0.45)" }}>
          © {new Date().getFullYear()} Bella Forever. Todos los derechos reservados.
        </p>
      </div>
    </footer>
  </div>
</Layout>
