---
import Layout from '../../layouts/Layout.astro';
import CatalogClient from '../../components/CatalogClient';
import JsonLdProductList from '../../components/seo/JsonLdProductList.astro';
import type { ProductWithRelations, Category } from '../../db/schema';
import { getDb } from '../../lib/db';
import { getProducts, getCategories } from '../../lib/services';
import { getProductImage } from '../../utils/image-helpers';

export const prerender = false;

let productsList: ProductWithRelations[] = [];
let categoriesList: Category[] = [];

try {
  const db = getDb();
  const [prods, cats] = await Promise.all([
    getProducts(db),
    getCategories(db),
  ]);
  productsList = prods;
  categoriesList = cats;
} catch (e: unknown) {
  console.error('Error al cargar datos del catálogo en SSR:', e);
}

const featured = productsList.filter(p => p.isFeatured || p.isNew);
const lcpProduct = featured.length > 0 ? featured[0] : productsList[0];
const lcpImageUrl = lcpProduct ? getProductImage(lcpProduct, lcpProduct.tones?.[0] ?? null) : null;
---

<Layout
  title="Catálogo de Productos | Bella Forever"
  description="Explora nuestra colección completa de maquillaje de alta gama: rubores, labiales, correctores, cejas y pestañas en Roldanillo."
>
  <JsonLdProductList slot="head" products={productsList} />
  {lcpImageUrl && (
    <link rel="preload" as="image" href={lcpImageUrl} fetchpriority="high" slot="head" />
  )}
  <CatalogClient
    client:idle
    initialProducts={productsList}
    initialCategories={categoriesList}
  />
</Layout>

